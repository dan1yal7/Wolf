<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WolfClient.MainPage"
             Background="#0a0a0a">

    <ContentPage.MenuBarItems>
        <MenuBarItem Text="File">
            <MenuFlyoutItem Text="Init new Repository..."
                            Clicked="OnInitClicked" 
                            />
            <MenuFlyoutItem Text="Clone"/>
            <MenuFlyoutItem Text="Exit"/>

        </MenuBarItem>

        <MenuBarItem Text="Edit">
            
        </MenuBarItem>


        <MenuBarItem Text="Repository">

        </MenuBarItem>

        <MenuBarItem Text="Branch">

        </MenuBarItem>


        <MenuBarItem Text="Commit">

        </MenuBarItem>


        <MenuBarItem Text="View">

        </MenuBarItem>

        <MenuBarItem Text="Help">

        </MenuBarItem>


    </ContentPage.MenuBarItems>


    <StackLayout Spacing="0">


        <BoxView HeightRequest="1" BackgroundColor="#2a2a2a" HorizontalOptions="Fill"/>


        <HorizontalStackLayout BackgroundColor="#1a1a1a" 
                       HeightRequest="44" 
                       Padding="8,0">

            <Border BackgroundColor="#2a2a2a"
            Stroke="#444444"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 4"
            Padding="10,4"
            HeightRequest="28"
            VerticalOptions="Center">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="&#xe97a;" FontFamily="MaterialIcons" TextColor="#aaaaaa" FontSize="15" VerticalOptions="Center"/>
                    <Label Text="main" TextColor="#ffffff" FontSize="12" VerticalOptions="Center"/>
                    <Label Text="&#xe5c5;" FontFamily="MaterialIcons" TextColor="#aaaaaa" FontSize="15" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>


             <!--TODO: Extract header and subheader into different components and call them  in Main page-->


 
            
            <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                <Label Text="south" FontFamily="MaterialIcons" TextColor="#aaaaaa" FontSize="14" HorizontalOptions="Center" Margin="0,2,0,0"/>
                <Button Text="Fetch" BackgroundColor="Transparent" TextColor="Gray" FontSize="Caption" Margin="0,-12,0,0"/>
            </VerticalStackLayout>

            <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                <Label Text="south" FontFamily="MaterialIcons" TextColor="#aaaaaa" FontSize="14" HorizontalOptions="Center" Margin="0,2,0,0"/>
                <Button Text="Pull" BackgroundColor="Transparent" TextColor="Gray" FontSize="Caption" Margin="0,-12,0,0"/>
            </VerticalStackLayout>

            <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                <Label Text="north" FontFamily="MaterialIcons" TextColor="#aaaaaa" FontSize="14" HorizontalOptions="Center"  Margin="0,2,0,0"/>
                <Button Text="Push" BackgroundColor="Transparent" TextColor="Gray" FontSize="Caption" Margin="0,-12,0,0"/>
            </VerticalStackLayout>


        </HorizontalStackLayout> 
        
        

       
    </StackLayout>

      
</ContentPage>